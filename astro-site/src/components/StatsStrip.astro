---
import { stats } from "@/data/content";
---

<section aria-label="Facts" class="border-y border-white/5 bg-ink-soft/40">
  <div class="mx-auto grid max-w-[1400px] grid-cols-2 gap-10 px-6 py-16 lg:grid-cols-4 lg:px-10">
    {stats.map((stat) => (
      <div class="flex flex-col gap-3 border-l hairline-gold pl-6">
        <div data-counter={stat.value} class="flex flex-col gap-2">
          <span class="font-serif text-4xl tracking-wide text-paper md:text-5xl">
            <span data-counter-num>0</span><span class="text-gold" data-counter-suffix>{stat.suffix}</span>
          </span>
          <span class="eyebrow">{stat.label}</span>
        </div>
      </div>
    ))}
  </div>
</section>
