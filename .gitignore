# Himalayan Reserve — Astro static frontend + PHP admin/API backend.

# dependencies (any depth — astro-site/node_modules etc.)
node_modules/

# astro build cache (astro-site/dist IS committed on purpose — deploy.sh
# ships it pre-built so the flaky Node/npm on cPanel is never required)
astro-site/.astro/

# env files — real DB creds live only on the server, never in git
.env*

# user-uploaded media — content, not code
php-backend/uploads/*
!php-backend/uploads/.gitkeep

# local scratch dirs used only during development on this machine
/deploy-final/
/local-test/
/tmp/
*.log

# misc
.DS_Store
*.pem
